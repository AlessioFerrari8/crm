{
  "index": "/index.html",
  "navigationUrls": ["/**", "!/api/**", "!/**/*.*"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico", "/index.html", "/manifest.webmanifest",
          "/*.css", "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/*.(svg|png|webp|woff2)"]
      }
    }
  ]
}
