# Copia in .env e riempi. Niente di questo file finisce in git.
# Segreti: openssl rand -base64 32 (uno diverso per riga)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# cifratura dei segreti a riposo: TOTP (MFA), password IMAP, token Google.
# Se la perdi, chi ha l'MFA attivo resta fuori e le caselle non scaricano
MFA_SECRET_KEY=

# database: con docker compose sono user/user, in locale quello che usi tu
DB_USERNAME=user
DB_PASSWORD=user

FRONTEND_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
# URL del backend visto da fuori: link di tracking e disiscrizione nelle email (FASE 8)
PUBLIC_API_URL=http://localhost:8080

# cookie: Secure vuole HTTPS, in locale resta false
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# email in uscita: resend | smtp | vuoto (= invio spento)
MAIL_PROVIDER=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# casella IMAP: ogni quanto si scarica (ms)
MAILSCANNER_DELAY_MS=120000

# webhook Cal.com: vuoto = endpoint spento (404)
CALCOM_WEBHOOK_SECRET=

# FASE 6: manual = l'XML si carica a mano sul portale del provider
SDI_PROVIDER=manual

# FASE 8: email di campagna al minuto (la reputazione del dominio)
CAMPAIGN_BATCH_PER_MINUTE=60

# FASE 17.1: firma dei link di accettazione dei preventivi (openssl rand -base64 32)
QUOTE_ACCEPT_SECRET=

# FASE 10: segreto del portale clienti, DIVERSO dagli altri (openssl rand -base64 48)
JWT_PORTAL_SECRET=

# FASE 13: Google Calendar, vuoti = integrazione spenta
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/google/callback

# in produzione: SWAGGER_ENABLED=false
SWAGGER_ENABLED=true